      { "id": "ParamArmR", "min": -1, "max": 1, "default": 0 },
      { "id": "ParamHandL", "min": 0, "max": 1, "default": 0 },
      { "id": "ParamHandR", "min": 0, "max": 1, "default": 0 },
      { "id": "ParamNotebookOpen", "min": 0, "max": 1, "default": 0 },
      { "id": "ParamNotebookX", "min": -1, "max": 1, "default": 0 },
      { "id": "ParamNotebookY", "min": -1, "max": 1, "default": 0 },
      { "id": "ParamDatabaseCharm", "min": -1, "max": 1, "default": 0 },
