{
  "version": 1,
  "id": "agent_pet_companion",
  "displayName": "Archivist Companion",
  "purpose": "Production specification for a real Live2D Cubism model export.",
  "status": "awaiting_source_art_and_cubism_export",
  "notRuntimeModel": true,
  "requiredRuntimeFiles": [
    "agent_pet_companion.model3.json",
    "agent_pet_companion.moc3",
    "textures/texture_00.png",
    "expressions/*.exp3.json",
    "motions/*/*.motion3.json",
    "agent_pet_companion.physics3.json",
    "agent_pet_companion.cdi3.json"
  ],
  "sourceArt": {
    "format": "layered PSD or Cubism .cmo3",
    "canvas": {
      "width": 4096,
      "height": 4096
    },
    "safeFrame": {
      "headCenter": { "x": 2048, "y": 920 },
      "waistCenter": { "x": 2048, "y": 2080 },
      "feetBottomY": 3820,
      "transparentPaddingPx": 220
    },
    "layerNaming": "ASCII stable layer names; localized display names may be added in cdi3."
  },
  "parts": [
    { "id": "PartRoot", "content": "whole model" },
    { "id": "PartHead", "content": "head, face, ears" },
    { "id": "PartHairBack", "content": "back hair and tails", "physics": true },
    { "id": "PartHairFront", "content": "bangs and ahoge", "physics": true },
    { "id": "PartEyeL", "content": "left eye" },
    { "id": "PartEyeR", "content": "right eye" },
    { "id": "PartBrowL", "content": "left brow" },
    { "id": "PartBrowR", "content": "right brow" },
    { "id": "PartMouth", "content": "mouth" },
    { "id": "PartBody", "content": "torso and jacket" },
    { "id": "PartArmL", "content": "left arm and hand" },
    { "id": "PartArmR", "content": "right arm and hand" },
    { "id": "PartStatusRibbon", "content": "chest status ribbon", "physics": true },
    { "id": "PartNotebook", "content": "floating notebook shard", "physics": true },
    { "id": "PartDatabaseCharm", "content": "database charm", "physics": true },
    { "id": "PartCards", "content": "memory, wiki, and task cards" },
    { "id": "PartPrivacyShield", "content": "privacy shield" }
  ],
  "parameters": {
    "standard": [
      { "id": "ParamAngleX", "min": -30, "max": 30, "default": 0 },
      { "id": "ParamAngleY", "min": -30, "max": 30, "default": 0 },
      { "id": "ParamAngleZ", "min": -30, "max": 30, "default": 0 },
      { "id": "ParamBodyAngleX", "min": -15, "max": 15, "default": 0 },
      { "id": "ParamBodyAngleY", "min": -10, "max": 10, "default": 0 },
      { "id": "ParamBodyAngleZ", "min": -10, "max": 10, "default": 0 },
      { "id": "ParamEyeLOpen", "min": 0, "max": 1, "default": 1 },
      { "id": "ParamEyeROpen", "min": 0, "max": 1, "default": 1 },
      { "id": "ParamEyeBallX", "min": -1, "max": 1, "default": 0 },
      { "id": "ParamEyeBallY", "min": -1, "max": 1, "default": 0 },
      { "id": "ParamBrowLY", "min": -1, "max": 1, "default": 0 },
      { "id": "ParamBrowRY", "min": -1, "max": 1, "default": 0 },
      { "id": "ParamBrowLAngle", "min": -1, "max": 1, "default": 0 },
      { "id": "ParamBrowRAngle", "min": -1, "max": 1, "default": 0 },
      { "id": "ParamMouthOpenY", "min": 0, "max": 1, "default": 0 },
      { "id": "ParamMouthForm", "min": -1, "max": 1, "default": 0 },
      { "id": "ParamBreath", "min": 0, "max": 1, "default": 0 }
    ],
