      { "id": "ParamWikiCards", "min": 0, "max": 1, "default": 0 },
      { "id": "ParamTaskNote", "min": 0, "max": 1, "default": 0 },
      { "id": "ParamPrivacyShield", "min": 0, "max": 1, "default": 0 },
      { "id": "ParamSleep", "min": 0, "max": 1, "default": 0 }
