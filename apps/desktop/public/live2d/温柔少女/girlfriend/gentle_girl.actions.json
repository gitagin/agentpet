{
  "version": 1,
  "description": "温柔少女模型的项目动作与表情映射。用于把 Agent Pet 的聊天、记忆、任务、Wiki、系统和朗读状态切换到真实 Cubism 表情/动作。",
  "actions": {
    "idle": {
      "expression": "default_pillow",
      "motion": {
        "group": "Idle",
        "index": 0
      },
      "petHint": "我在这里陪着你，双击可以打开主舞台。",
      "controlSummary": "待机：轻呼吸、轻微摆动，默认显示抱枕形态。"
    },
    "chat_listen": {
      "expression": "asmr",
      "motion": {
        "group": "Chat",
        "index": 0
      },
      "petHint": "我在认真听你说。",
      "controlSummary": "倾听：身体前倾、视线抬起，切到 ASMR 倾听表情。"
    },
    "chat_think": {
      "expression": "星星眼",
      "motion": {
        "group": "Chat",
        "index": 1
      },
      "petHint": "我正在想怎么回答你。",
      "controlSummary": "思考：眼神左右搜索，眉毛轻动，切到星星眼。"
    },
    "chat_talk": {
      "expression": "asmr1",
      "motion": {
        "group": "Chat",
        "index": 2
      },
      "petHint": "我正在回复你。",
      "controlSummary": "回复：口型循环、轻手势，适合流式回答和语音。"
    },
    "chat_done": {
      "expression": "default_pillow",
      "motion": {
        "group": "Chat",
        "index": 3
      },
      "petHint": "回复完成。",
      "controlSummary": "完成：轻点头并回到抱枕待机形态。"
    },
    "memory_search": {
      "expression": "星星眼",
      "motion": {
        "group": "Memory",
        "index": 0
      },
      "petHint": "我正在检索记忆线索。",
      "controlSummary": "记忆检索：视线扫描、头部左右移动。"
    },
    "memory_found": {
      "expression": "爱心眼",
      "motion": {
        "group": "Memory",
        "index": 1
      },
      "petHint": "翻到相关记忆了。",
      "controlSummary": "记忆命中：开心确认、轻举手。"
    },
    "memory_not_found": {
      "expression": "CRY",
      "motion": {
        "group": "Memory",
        "index": 2
      },
      "petHint": "暂时没翻到相关记忆。",
      "controlSummary": "记忆未命中：轻摇头、嘴角下压。"
    },
    "memory_save_diary": {
      "expression": "default_pillow",
      "motion": {
        "group": "Memory",
        "index": 3
      },
      "petHint": "这段对话已经整理到本地日记。",
      "controlSummary": "日记沉淀：身体轻前倾，像把内容收进本地档案。"
    },
    "memory_save_long_term": {
      "expression": "爱心眼",
      "motion": {
        "group": "Memory",
        "index": 3
      },
      "petHint": "值得长期记住的内容已经沉淀。",
      "controlSummary": "长期记忆：温柔确认并保存。"
    },
    "memory_confirm_needed": {
      "expression": "黑脸",
      "motion": {
        "group": "Memory",
        "index": 4
      },
      "petHint": "有记忆需要你确认。",
      "controlSummary": "确认请求：表情收敛，等待用户选择。"
    },
    "memory_privacy_guard": {
      "expression": "黑脸",
      "motion": {
        "group": "Memory",
        "index": 5
      },
      "petHint": "这部分内容需要先保护隐私。",
      "controlSummary": "隐私保护：压低眼神和动作幅度。"
    },
    "memory_revert": {
      "expression": "CRY",
      "motion": {
        "group": "Memory",
        "index": 6
      },
      "petHint": "这次整理记录已经撤回。",
      "controlSummary": "撤回：轻摇、回收状态。"
    },
    "task_create": {
      "expression": "facehand",
      "motion": {
        "group": "Task",
        "index": 0
      },
      "petHint": "任务已经记录。",
      "controlSummary": "任务创建：轻记一笔，手部参数配合。"
    },
    "task_reminder": {
      "expression": "hat",
      "motion": {
        "group": "Task",
        "index": 1
      },
      "petHint": "提醒时间到了。",
      "controlSummary": "任务提醒：短促晃动和眨眼提示。"
    },
    "task_complete": {
      "expression": "爱心眼",
      "motion": {
        "group": "Task",
        "index": 2
      },
      "petHint": "这件事完成了。",
      "controlSummary": "任务完成：小幅庆祝，避免遮挡桌面。"
    },
    "wiki_organize": {
      "expression": "default_pillow",
      "motion": {
        "group": "Wiki",
        "index": 0
      },
      "petHint": "我正在整理资料。",
      "controlSummary": "Wiki 整理：左右扫描、手部整理。"
    },
    "wiki_check": {
      "expression": "星星眼",
      "motion": {
        "group": "Wiki",
        "index": 1
      },
      "petHint": "我正在检查资料格式。",
      "controlSummary": "Wiki 检查：专注抬眉、视线下移。"
    },
    "wiki_archive": {
      "expression": "default_pillow",
      "motion": {
        "group": "Wiki",
        "index": 2
      },
      "petHint": "资料已经归档。",
      "controlSummary": "Wiki 归档：点头确认、回到抱枕待机形态。"
    },
    "continuity_remember": {
      "expression": "default_pillow",
      "motion": {
        "group": "Continuity",
        "index": 0
      },
      "petHint": "我还记着未完的话题。",
      "controlSummary": "连续性提醒：柔和微笑和轻摆。"
    },
    "emotion_comfort": {
      "expression": "pillow_comfort",
      "motion": {
        "group": "Continuity",
        "index": 1
      },
      "petHint": "我会慢一点陪你。",
      "controlSummary": "情绪陪伴：眼睛半合、动作放缓。"
    },
    "system_connecting": {
      "expression": "星星眼",
      "motion": {
        "group": "System",
        "index": 0
      },
      "petHint": "正在连接本地后端。",
      "controlSummary": "连接中：视线轮询和轻微搜索动作。"
    },
    "system_offline": {
      "expression": "CRY",
      "motion": {
        "group": "System",
        "index": 1
      },
      "petHint": "离线待命，双击可以打开主舞台检查。",
      "controlSummary": "离线：低功耗待机、半闭眼。"
    },
    "system_error": {
      "expression": "生气",
      "motion": {
        "group": "System",
        "index": 2
      },
      "petHint": "有一处状态需要检查。",
      "controlSummary": "错误：短促晃动但动作克制。"
    },
    "system_diagnosed": {
      "expression": "爱心眼",
      "motion": {
        "group": "System",
        "index": 3
      },
      "petHint": "诊断完成，可以回主舞台查看。",
      "controlSummary": "诊断完成：微笑点头。"
    },
    "tts_speaking": {
      "expression": "asmr1",
      "motion": {
        "group": "Reaction",
        "index": 0
      },
      "petHint": "语音朗读反馈已开启。",
      "controlSummary": "TTS：口型循环、轻手势同步。"
    },
    "sleep_quiet": {
      "expression": "default_pillow",
      "motion": {
        "group": "Idle",
        "index": 3
      },
      "petHint": "安静待机中。",
      "controlSummary": "安静模式：半闭眼、低幅呼吸。"
    },
    "celebrate_small": {
      "expression": "爱心眼",
      "motion": {
        "group": "Reaction",
        "index": 1
      },
      "petHint": "做得不错。",
      "controlSummary": "轻庆祝：短促开心反馈。"
    }
  }
}
